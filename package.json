{
  "name": "antsy-tek",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "prerender-routes": "node scripts/prerender-routes.mjs",
    "build": "node scripts/prerender-routes.mjs && nuxt generate",
    "generate": "nuxt generate",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit tests/component",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "typecheck": "vue-tsc --noEmit -p .nuxt/tsconfig.app.json",
    "lint": "eslint ."
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.0",
    "@iconify-json/simple-icons": "^1.2.0",
    "@nuxt/ui": "^4.0.0",
    "@supabase/supabase-js": "^2.0.0",
    "marked": "^18.0.0",
    "marked-footnote": "^1.0.0",
    "nuxt": "^4.0.0",
    "sanitize-html": "^2.0.0",
    "tailwindcss": "^4.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.0.0 || ^5.0.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.0.0",
    "@playwright/test": "^1.50.0",
    "@types/sanitize-html": "^2.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.0",
    "eslint": "^9.0.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.0.0",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.0.0"
  }
}
